# Default: existing Firebase. No server secrets needed for browser access.
VITE_ACCOUNT_BACKEND=firebase
# To run the preserved OCI adapter explicitly, set VITE_ACCOUNT_BACKEND=oci.
# Local API development. Copy to .env and configure on the server only.
APP_ORIGIN=http://localhost:5173
PORT=3001
DATABASE_URL=postgresql://mimir:REPLACE_WITH_RANDOM_HEX@localhost:5432/mimir
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: required only if the BLABLALINK upstream requires a service session.
BLABLA_COOKIE=
# Required to compute new MIMIR scores. No key = missing scores, never fake values.
DILDORO_API_KEY=

# Docker / OCI pre-domain testing over SSH tunnel:
# APP_ORIGIN=http://localhost:8080
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
SITE_ADDRESS=:80
WEB_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
