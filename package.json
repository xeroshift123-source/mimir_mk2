{
  "name": "mimir-mk2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "check:server": "tsc -p server/tsconfig.json",
    "build:server": "npm run check:server && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/index.js",
    "test:server": "node --import tsx --test server/tests/*.test.ts",
    "test": "node tests/profile-controls.test.cjs && npm run test:games && npm run test:server",
    "test:games": "node --import tsx --test tests/*.test.ts",
    "test:firebase:live": "node --import tsx tests/firebase-live.check.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "firebase": "12.6.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
